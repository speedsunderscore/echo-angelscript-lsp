{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AngelScript",
  "scopeName": "source.angelscript",
  "fileTypes": ["as"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#modifiers" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.angelscript",
          "begin": "//",
          "end": "$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.angelscript" }
          }
        },
        {
          "name": "comment.block.angelscript",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.angelscript" }
          }
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.angelscript",
          "match": "^\\s*(#)\\s*(include|pragma|if|ifdef|ifndef|else|endif|define|undef)\\b.*$",
          "captures": {
            "1": { "name": "punctuation.definition.directive.angelscript" },
            "2": { "name": "keyword.control.directive.angelscript" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.angelscript",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        },
        {
          "name": "string.quoted.double.angelscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            {
              "name": "invalid.illegal.newline.angelscript",
              "match": "\\n"
            }
          ]
        },
        {
          "name": "string.quoted.single.angelscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string-escapes" },
            {
              "name": "invalid.illegal.newline.angelscript",
              "match": "\\n"
            }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.angelscript",
          "match": "\\\\([\\\\'\"nrtb0fav?]|x[0-9A-Fa-f]{1,4}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})"
        },
        {
          "name": "invalid.illegal.escape.angelscript",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.angelscript",
          "match": "\\b0[xX][0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.octal.angelscript",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.binary.angelscript",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.float.angelscript",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.float.angelscript",
          "match": "\\b\\d+[eE][+-]?\\d+[fFdD]?\\b"
        },
        {
          "name": "constant.numeric.float.angelscript",
          "match": "\\b\\d+[fFdD]\\b"
        },
        {
          "name": "constant.numeric.integer.angelscript",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.angelscript",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.angelscript",
          "match": "\\b(null)\\b"
        },
        {
          "name": "variable.language.angelscript",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.flow.angelscript",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|try|catch|throw|delete)\\b"
        },
        {
          "name": "keyword.control.import.angelscript",
          "match": "\\b(import|from|namespace)\\b"
        },
        {
          "name": "keyword.operator.word.angelscript",
          "match": "\\b(and|or|xor|not|is|in|new)\\b"
        },
        {
          "name": "keyword.other.angelscript",
          "match": "\\b(get|set|property|enum|funcdef|typedef|function|mixin|explicit|inout|out|auto)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.angelscript",
          "match": "\\b(void|bool|int|int8|int16|int32|int64|uint|uint8|uint16|uint32|uint64|float|double|cast)\\b"
        },
        {
          "name": "support.type.builtin.angelscript",
          "match": "\\b(string|array|dictionary|ref|weakref|funcref)\\b"
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.angelscript",
          "match": "\\b(const|final|override|abstract|shared|external|private|protected|public)\\b"
        }
      ]
    },
    "class-declaration": {
      "patterns": [
        {
          "match": "\\b(class|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.angelscript" },
            "2": { "name": "entity.name.type.class.angelscript" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.angelscript" },
            "2": { "name": "entity.name.type.enum.angelscript" }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_:]*)",
          "captures": {
            "1": { "name": "keyword.control.angelscript" },
            "2": { "name": "entity.name.namespace.angelscript" }
          }
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.angelscript" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.handle.angelscript",
          "match": "@="
        },
        {
          "name": "keyword.operator.handle.angelscript",
          "match": "@"
        },
        {
          "name": "keyword.operator.assignment.compound.angelscript",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|>>>=|\\*\\*=)"
        },
        {
          "name": "keyword.operator.comparison.angelscript",
          "match": "(==|!=|<=|>=|<(?!<)|>(?!>))"
        },
        {
          "name": "keyword.operator.logical.angelscript",
          "match": "(&&|\\|\\||!(?!=))"
        },
        {
          "name": "keyword.operator.bitwise.angelscript",
          "match": "(<<|>>>|>>|&|\\||\\^|~)"
        },
        {
          "name": "keyword.operator.increment.angelscript",
          "match": "(\\+\\+|--)"
        },
        {
          "name": "keyword.operator.arithmetic.angelscript",
          "match": "(\\*\\*|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.angelscript",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.angelscript",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.namespace.angelscript",
          "match": "::"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.angelscript",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.angelscript",
          "match": ","
        },
        {
          "name": "punctuation.accessor.angelscript",
          "match": "\\."
        },
        {
          "name": "punctuation.section.parens.angelscript",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.angelscript",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.angelscript",
          "match": "[{}]"
        }
      ]
    }
  }
}
